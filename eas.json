{
  "cli": {
    "version": ">= 5.9.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_USE_LOCALHOST": "0",
        "EXPO_PUBLIC_USE_LOCAL": "0"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {}
    },
    "production": {
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "cristi.david87@gmail.com"
      }
    }
  }
}
